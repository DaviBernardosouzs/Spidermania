# ======================================================
# CONFIGURAÇÃO DAS VARIÁVEIS DE AMBIENTE
# ======================================================

# Crie um arquivo chamado ".env" na raiz do projeto.
#
# Exemplo:
#
# SpiderManIA/
# ├── .env
# ├── env.config
# ├── package.json
# ├── context.md
# └── src/
#
# NÃO coloque chaves ou senhas reais neste arquivo.
# O arquivo env.config pode ser enviado para o GitHub.
# O arquivo .env NÃO deve ser enviado para o GitHub.


# ======================================================
# GEMINI API
# ======================================================

# Chave da API do Google Gemini.
#
# Usada para:
# - respostas da IA;
# - interpretação de áudio;
# - geração de embeddings;
# - geração de voz com Gemini TTS.
#
# Exemplo no .env:
#
# IA_APIKEY=sua_chave_da_api_gemini

IA_APIKEY=


# ======================================================
# BANCO DE DADOS
# ======================================================

# URL de conexão com o PostgreSQL.
#
# Usada pelo sistema de memória do PeterPark para:
# - salvar memórias;
# - buscar memórias;
# - armazenar embeddings;
# - atualizar informações do usuário.
#
# Exemplo no .env:
#
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

DATABASE_URL=